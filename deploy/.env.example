# Copy to deploy/.env and adjust before: docker compose --env-file .env up -d
#
# LAN URL (default port avoids qBittorrent Web UI on 8080):
#   http://<your-host-lan-ip>:8090/

POSTGRES_USER=localcloud
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=localcloud

DATABASE_URL=postgres://localcloud:change-me-use-a-long-random-string@postgres:5432/localcloud?sslmode=disable

# Same port inside container and on the LAN (typical):
LOCAL_CLOUD_PORT=8090
LOCAL_CLOUD_HOST_PORT=8090

# Optional override; default is :${LOCAL_CLOUD_PORT}
# LOCAL_CLOUD_HTTP_ADDR=:8090

LOCAL_CLOUD_DATA_DIR=/data
LOCAL_CLOUD_JWT_SECRET=change-me-at-least-32-random-bytes-hex-or-base64

# First boot only (when no users exist). Defaults to admin/admin if omitted.
LOCAL_CLOUD_ADMIN_USERNAME=admin
LOCAL_CLOUD_ADMIN_PASSWORD=admin
# LOCAL_CLOUD_ADMIN_QUOTA_BYTES=107374182400

LOCAL_CLOUD_LOG_LEVEL=info

# Security: LAN-only client filter is always enabled in the app (non-private IPs get 403).
# Do not port-forward this port; do not use VPN remote access (see docs/OPERATOR_RUNBOOK.md).

# If you put a reverse proxy on the LAN, list its CIDRs so X-Forwarded-For is trusted (comma-separated).
# Leave empty otherwise — spoofed X-Forwarded-For headers are ignored.
# LOCAL_CLOUD_TRUSTED_PROXY_CIDRS=192.168.1.0/24

# Optional: bind Docker to your LAN IP only (edit deploy/docker-compose.yml ports), e.g.:
#   ports:
#     - "192.168.1.50:8090:8090"

# Optional HTTPS on the LAN (protects tokens and file bytes from passive Wi‑Fi sniffing).
# Mount PEM files into the container (see deploy/tls/) and set paths inside the container:
# LOCAL_CLOUD_TLS_CERT=/tls/fullchain.pem
# LOCAL_CLOUD_TLS_KEY=/tls/privkey.pem
# Then open https://<lan-ip>:8090/ (accept your CA or self-signed cert once per device).

# Optional OnlyOffice Document Server (richer Office preview than LibreOffice PDF).
# Start with: docker compose --profile onlyoffice up -d
# ONLYOFFICE_HOST_PORT=8082
# LOCAL_CLOUD_ONLYOFFICE_PUBLIC_URL=http://192.168.1.50:8082
# LOCAL_CLOUD_INTERNAL_BASE_URL=http://localcloud-api:8090
